# Pin this to a release such as v0.1.0 for reproducible deployments.
MDSLENS_IMAGE_TAG=latest

# A reverse proxy on the same host connects to this loopback-only port.
MDSLENS_LOCAL_PORT=18088

# Only these API, MDS, and SSH hosts can be reached through the gateway.
MDSLENS_ALLOWED_HOSTS=202.127.204.12,202.127.204.26,202.127.204.41

# Increase this only for unusually large waveform requests.
MDSLENS_MEMORY_LIMIT=1g
